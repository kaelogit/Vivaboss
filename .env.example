# Vivaboss Fusion — environment
# Copy to .env.local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (see docs/SUPABASE_SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: open /admin without Supabase (ignored in production)
ALLOW_ADMIN_PREVIEW=true

# Stripe (GBP)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping (GBP)
SHIPPING_GBP=4.99
SHIPPING_FREE_OVER_GBP=0

# Email (Resend) — admin always gets admin@vivabossfusion.co.uk
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vivaboss Fusion <onboarding@resend.dev>
ADMIN_NOTIFICATION_EMAIL=admin@vivabossfusion.co.uk

NEXT_PUBLIC_WHATSAPP_E164=+44 7979481352
NEXT_PUBLIC_PHONE=+44 7979481352
NEXT_PUBLIC_CONTACT_EMAIL=hello@vivabossfusion.co.uk
