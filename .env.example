# Vivaboss Fusion — environment
# Copy to .env.local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (see docs/SUPABASE_SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only: open /admin without Supabase (ignored in production)
ALLOW_ADMIN_PREVIEW=true

# Stripe (GBP)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping (GBP)
SHIPPING_GBP=4.99
SHIPPING_FREE_OVER_GBP=0

# Email (Resend) — domain vivabossfusion.co.uk must be verified
RESEND_API_KEY=
# Optional global override (else per-kind defaults below apply)
# RESEND_FROM_EMAIL=Vivaboss Fusion <hello@vivabossfusion.co.uk>
RESEND_FROM_ORDER=Vivaboss Orders <order@vivabossfusion.co.uk>
RESEND_FROM_BOOKING=Vivaboss Bookings <booking@vivabossfusion.co.uk>
RESEND_FROM_COURIER=Vivaboss Courier <courier@vivabossfusion.co.uk>
RESEND_FROM_CUSTOM=Vivaboss Custom <custom@vivabossfusion.co.uk>
RESEND_FROM_CONTACT=Vivaboss <hello@vivabossfusion.co.uk>
# Customer “Reply” on outbound mail
RESEND_REPLY_TO=admin@vivabossfusion.co.uk
ADMIN_NOTIFICATION_EMAIL=admin@vivabossfusion.co.uk

NEXT_PUBLIC_WHATSAPP_E164=+44 7979481352
NEXT_PUBLIC_PHONE=+44 7979481352
NEXT_PUBLIC_CONTACT_EMAIL=hello@vivabossfusion.co.uk
